<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Keeps chapter processing alive while the app is in the background (ADR-0007). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Android 13+ asks for this once, from the app's own explainer sheet. Denial still lets processing run. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.lectiobackground.ProcessingService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>
</manifest>
